---
import BaseLayout from '@layouts/BaseLayout.astro';

import { getDataPages, getAllPagesBySlug } from '@libs/dataPages';
const slugs = await getAllPagesBySlug();
const slug = "/home";
console.log("Slugs:", slugs);

const dataPage = await getDataPages();
const homePage = dataPage.find((page: any) => page.slugPage === slug);


const { titlePage,  processedContentPage } = homePage || { titlePage: "Página no encontrada", slugPage: "404" };


---

<BaseLayout title={titlePage}>
	<h1>{titlePage}</h1>
	<p set:html={processedContentPage}/>
	
</BaseLayout>