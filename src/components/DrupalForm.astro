---
// src/components/form/FormRenderer.astro
import InputText from "./form/InputText.astro";
import InputEmail from "./form/InputEmail.astro";
import InputPhone from "./form/InputPhone.astro";
import SelectCountry from "./form/SelectCountry.astro";
import SelectCommercialList from "./form/SelectCommercialList.astro";
import CheckboxConsent from "./form/Checkbox.astro";
import SubmitButton from "./form/SubmitButton.astro";


const { formData } = Astro.props;
const { formElements = [], validation = [], items = [] } = formData;

// función para obtener reglas de validación de cada campo
function getFieldValidations(field: string) {
  return validation.filter((v: any) => v.field === field);
}
---

<form id="dynamic-form" class="space-y-4">
  {formElements.map((el: any) => {
    const rules = getFieldValidations(el.field);

    switch (el.type) {
      case "texttype":
        return <InputText field={el} validations={rules} />;
      case "emailtype":
        return <InputEmail field={el} validations={rules} />;
      case "phonetype":
        return <InputPhone field={el} validations={rules} />;
      case "countrytype":
        return <SelectCountry field={el} validations={rules} />;
      case "commerciallisttype":
        return <SelectCommercialList field={el} items={items} validations={rules} />;
      case "consenttype":
        return <CheckboxConsent field={el} />;
      case "submittype":
        return <SubmitButton label={el.submit_label} />;
      default:
        return null;
    }
  })}
</form>
<script type="module">
  const form = document.getElementById("dynamic-form");

  // Función para aplicar validaciones simples
  function validateField(value, rules) {
    for (const rule of rules) {
      if (rule.plugin === "minlength" && value.length < rule.length) {
        return rule.error_message;
      }
      if (rule.plugin === "maxlength" && value.length > rule.length) {
        return rule.error_message;
      }
      if (rule.plugin === "regex" && !new RegExp(rule.pattern).test(value)) {
        return rule.error_message;
      }
    }
    return null;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    // Validaciones dinámicas
    const errors = [];
    for (const el of formElements) {
      const value = data[el.field] ?? "";
      const rules = validation.filter((v) => v.field === el.field);
      const error = validateField(value, rules);
      if (error) errors.push({ field: el.field, message: error });
    }

    if (errors.length > 0) {
      console.log("Errores de validación:", errors);
      alert("Corrige los errores antes de enviar ❌");
      return;
    }

    // Mapear a crm_field
    const payload = {};
    for (const el of formElements) {
      if (el.crm_field) {
        payload[el.crm_field] = data[el.field];
      }
    }

    console.log("Payload a enviar:", payload);

    try {
      // Endpoint simulado para test, cambia al endpoint real de Drupal cuando lo tengas
      const response = await fetch("http://drupaldev.taiarts.com/admin/gge-af-connector/submission", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        alert("Formulario enviado ✅");
        form.reset();
      } else {
        const resJson = await response.json().catch(() => null);
        console.error("Error en respuesta:", resJson);
        alert(`Error al enviar ❌ (status ${response.status})`);
      }
    } catch (err) {
      console.error("Error al enviar formulario:", err);
      alert("Error de conexión ❌");
    }
  });
</script>
